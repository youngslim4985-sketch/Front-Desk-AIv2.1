# PostgreSQL research environment
# Copy to a local .env file if needed.
# NEVER commit real credentials.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Experiment defaults
EXPERIMENT_DURATION_SECONDS=60
SAMPLE_INTERVAL_SECONDS=1

# Subtransaction experiment
SUBXACT_COUNT=100

# MultiXact experiment
MULTIXACT_CLIENTS=4
MULTIXACT_ITERATIONS=1000

# Benchmark
BENCHMARK_ROWS=10000
